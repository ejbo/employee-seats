# ── 数据库 ─────────────────────────────────────────────────────────────────────
# 共享 Postgres 实例上使用独立 schema：?schema=employee_seats（Prisma 的 _prisma_migrations 也会落在这个 schema）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=employee_seats&connection_limit=10"

# ── 会话 ───────────────────────────────────────────────────────────────────────
# openssl rand -base64 32 ；每个环境一份，设定后保持稳定（更换会让所有人重新登录）
AUTH_SECRET=
# 应用的公网地址。子路径部署时必须以 /api/auth 结尾（Auth.js 由它推导回调地址）：
#   根域名：   AUTH_URL=https://seats.rnd.huawei.com
#   子路径：   AUTH_URL=https://cari.rnd.huawei.com/seats/api/auth
AUTH_URL=http://localhost:3000

# ── 华为 SSO（UniPortal / IDaaS OAuth2）────────────────────────────────────────
ENABLE_SSO=false
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=https://uniportal.huawei.com/saaslogin1/oauth2/authorize
SSO_ACCESS_TOKEN_URL=https://uniportal.huawei.com/saaslogin1/oauth2/accesstoken
SSO_USERINFO_URL=https://uniportal.huawei.com/saaslogin1/oauth2/userinfo
SSO_SCOPE=base.profile
# 内网证书由内部 CA 签发；优先用 NODE_EXTRA_CA_CERTS（systemd Environment= 行），否则关掉校验
SSO_VERIFY_SSL=false

# ── 出口代理（仅内网部署、且需要访问外网时）──────────────────────────────────────
USE_PROXY=false
HUAWEI_PROXY_HOST=proxyca.huawei.com
HUAWEI_PROXY_PORT=8080
# PROXY_BYPASS=.huawei.com,10.0.0.0/8
# PROXY_TLS_INSECURE=false
# PROXY_CA_FILE=
# INTERNAL_TLS_INSECURE=false

# ── 本地开发登录（无需 UniPortal；生产环境禁止开启）────────────────────────────
ENABLE_DEV_LOGIN=true

# ── 权限引导 ───────────────────────────────────────────────────────────────────
# 逗号分隔的工号；首次 SSO 登录即成为超级管理员（只升不降）
SUPER_ADMIN_W3_IDS=

# ── 文件存储 ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=20
MAX_IMPORT_ROWS=5000

# ── 子路径部署（构建期变量，不放在 .env 里也可以，见 deploy/）──────────────────
# NEXT_BASE_PATH=/seats

# ── AI 能力（可选；不配置时「识别户型图」「照片生成物件」退化为手动）──────────────
# 开发机（OpenAI）：shell 里已 export OPENAI_API_KEY 时只需这两行（base URL 默认 api.openai.com）
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4.1
# 开发机：Claude API（公网，需要走代理时把 LLM_USE_PROXY 设为 true）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
# LLM_USE_PROXY=true
# 内网：ai4news 模型网关（OpenAI 兼容，直连不走代理），视觉模型 GLM-4.6V
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://ai4news.rnd.huawei.com/model/v1
# LLM_MODEL=zai-org/GLM-4.6V
# LLM_API_KEY=<网关 key>
# LLM_USE_PROXY=false
# LLM_MAX_CONCURRENT=4
# LLM_COMPLETE_TIMEOUT_MS=180000
